# Formbricks AGPL Fork — Docker Environment Template
# Copy this file to docker/.env and fill in values.
# NEVER commit docker/.env to git (it is gitignored).

# Formbricks Application
WEBAPP_URL=https://your-domain.example
NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# PostgreSQL — generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# OIDC SSO (UPorto or other provider)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_DISPLAY_NAME=
OIDC_SIGNING_ALGORITHM=RS256
# Set to 1 to enable OIDC-only mode (disable email/password auth, enable SSO-first login)
# OIDC_ONLY=1

# Hub API
HUB_API_KEY=

# Cube.js Analytics
CUBEJS_API_SECRET=
CUBEJS_JWT_ISSUER=formbricks-web
CUBEJS_JWT_AUDIENCE=formbricks-cube

# Telemetry is DISABLED by default in this AGPL fork (no phone-home).
TELEMETRY_DISABLED=1

# SAML SSO (configure when enabling SAML)
# SAML_IDP_SSO_URL=https://your-idp.com/sso/saml
# SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SAML_IDP_ENTITY_ID=https://your-idp.com/entity
# SAML_IDP_METADATA_URL=https://your-idp.com/metadata

# PostgreSQL Backup (S3-compatible) — configure to enable postgres-backup service
# S3_ENDPOINT_URL=https://s3.your-provider.com
# S3_BUCKET_NAME=formbricks-backups
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
